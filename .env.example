# ---------------------------------------------------------------------------
# Base de données (MySQL 8)
# ---------------------------------------------------------------------------
# Format : mysql://utilisateur:motdepasse@hote:port/base
# Laragon / XAMPP par défaut : mysql://root:@127.0.0.1:3306/royal_palace
# Docker Compose (voir docker-compose.yml) : mysql://royal:royal@127.0.0.1:3306/royal_palace
DATABASE_URL="mysql://root:@127.0.0.1:3306/royal_palace"

# Utilisés uniquement par docker-compose.yml
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=royal_palace
MYSQL_USER=royal
MYSQL_PASSWORD=royal

# ---------------------------------------------------------------------------
# Authentification
# ---------------------------------------------------------------------------
# Obligatoire en production. Génère une valeur avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-moi-en-production"
JWT_EXPIRES_IN=7d

# Laisse vide pour désactiver POST /api/auth/register.
# Si renseigné, ce code doit être envoyé dans le champ `adminInviteCode`.
ADMIN_INVITE_CODE=

# ---------------------------------------------------------------------------
# E-mails (Resend) — optionnel : sans clé, les envois sont simplement ignorés
# ---------------------------------------------------------------------------
RESEND_API_KEY=
FROM_EMAIL="noreply@royalpalaceantsirabe.com"
HOTEL_EMAIL="royalpalace.resa@moov.mg"

# ---------------------------------------------------------------------------
# Serveur
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Mettre à true pour rejouer `npm run test:api` sans buter sur la limite de
# débit (30 écritures / 15 min). Toujours ignoré quand NODE_ENV=production.
DISABLE_RATE_LIMIT=false
# Origines autorisées, séparées par des virgules.
# En développement, localhost:5173 / :3000 / :3002 sont toujours acceptés.
# En production, SEULE cette liste est acceptée — elle doit être renseignée.
CORS_ORIGIN=http://localhost:5173
