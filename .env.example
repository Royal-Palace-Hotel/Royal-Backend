# MySQL 8 local development defaults (also used by Docker Compose)
DATABASE_URL="mysql://royal:royal@127.0.0.1:3306/royal_palace"
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=royal_palace
MYSQL_USER=royal
MYSQL_PASSWORD=royal

# Local-only placeholder. Replace it with a secret before any deployment.
JWT_SECRET="LOCAL_DEV_ONLY_CHANGE_BEFORE_PRODUCTION"

# Ask the team lead for a Resend key; emails are skipped while this is blank.
RESEND_API_KEY=
FROM_EMAIL="noreply@royalpalaceantsirabe.com"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
