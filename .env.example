# ---------------------------------------------------------------------------
# Base de données (MySQL 8)
# ---------------------------------------------------------------------------
# Format : mysql://utilisateur:motdepasse@hote:port/base
# Laragon / XAMPP par défaut : mysql://root:@127.0.0.1:3306/royal_palace
# Docker Compose (voir docker-compose.yml) : mysql://royal:royal@127.0.0.1:3306/royal_palace
DATABASE_URL="mysql://root:@127.0.0.1:3306/royal_palace"

# Utilisés uniquement par docker-compose.yml
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=royal_palace
MYSQL_USER=royal
MYSQL_PASSWORD=royal

# ---------------------------------------------------------------------------
# Authentification
# ---------------------------------------------------------------------------
# Obligatoire en production. Génère une valeur avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-moi-en-production"
JWT_EXPIRES_IN=7d

# Laisse vide pour désactiver POST /api/auth/register.
# Si renseigné, ce code doit être envoyé dans le champ `adminInviteCode`.
ADMIN_INVITE_CODE=

# ---------------------------------------------------------------------------
# E-mails (SMTP Gmail, gratuit) — optionnel : sans ces deux valeurs, les
# envois sont simplement ignorés, l'API continue de fonctionner.
#
# Préparation du compte Gmail de l'hôtel :
#   1. Activer la validation en deux étapes (obligatoire pour l'étape 2)
#      https://myaccount.google.com/signinoptions/twosv
#   2. Générer un mot de passe d'application de 16 caractères
#      https://myaccount.google.com/apppasswords
#      Ce n'est PAS le mot de passe du compte. Les espaces affichés par Google
#      (« abcd efgh ijkl mnop ») sont retirés automatiquement.
#
# L'expéditeur vu par le client est GMAIL_USER, habillé de FROM_NAME : Gmail
# n'autorise pas d'envoyer depuis une autre adresse que celle authentifiée.
# Limite d'un compte Gmail gratuit : environ 100 e-mails/jour en SMTP.
# ---------------------------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=
FROM_NAME="Royal Palace Antsirabe"

# Destinataire des notifications internes (nouvelles réservations, messages).
HOTEL_EMAIL="royalpalace.resa@moov.mg"

# ---------------------------------------------------------------------------
# Traduction automatique FR → EN du back-office (DeepL) — optionnel.
#
# Renseignée, cette clé fait remplir les champs « (EN) » du back-office dès que
# le champ français est saisi. La proposition reste modifiable, et rien ne change
# si la clé est absente : les champs anglais se remplissent alors à la main.
#
# Obtenir une clé gratuite (500 000 caractères/mois, sans engagement) :
#   1. créer un compte « DeepL API Free » sur
#      https://www.deepl.com/pro-api
#   2. copier la clé dans l'onglet « Clés d'API » du compte
#      https://www.deepl.com/your-account/keys
#      Une clé gratuite se termine par « :fx » — le domaine à appeler en est
#      déduit automatiquement, il n'y a rien d'autre à régler.
#
# Le serveur ne relit pas .env à chaud : redémarrer l'API après l'avoir collée.
# ---------------------------------------------------------------------------
DEEPL_API_KEY=

# Variante d'anglais produite : EN-GB (britannique) ou EN-US (américain).
DEEPL_TARGET_LANG=EN-GB

# ---------------------------------------------------------------------------
# Serveur
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Mettre à true pour rejouer `npm run test:api` sans buter sur la limite de
# débit (30 écritures / 15 min). Toujours ignoré quand NODE_ENV=production.
DISABLE_RATE_LIMIT=false
# Origines autorisées, séparées par des virgules.
# En développement, localhost:5173 / :3000 / :3002 sont toujours acceptés.
# En production, SEULE cette liste est acceptée — elle doit être renseignée.
CORS_ORIGIN=http://localhost:5173
